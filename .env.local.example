# Copy to .env.local and fill in. Restart `npm run dev` after changing.

# WhatsApp number that receives enquiries: country code + number, digits only.
NEXT_PUBLIC_WHATSAPP=919566514555

# Public address of the live site (no trailing slash). Used for links, sitemap and sharing.
NEXT_PUBLIC_SITE_URL=https://www.sunoptics.in

# Contact details shown on the site and in search-result markup.
# Email is still pending from the owner: leave blank to hide it.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_PHONE=+91 95665 14555

# Google Search Console HTML-tag verification code (content value only). Optional.
NEXT_PUBLIC_GSC_VERIFICATION=
